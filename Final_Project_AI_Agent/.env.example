# Copy to .env and fill in values. Never commit .env.

# demo = offline scripted controller (tests)
# openai = real LLM tool-calling baseline (Milestone 2 requirement)
AGENT_MODE=demo

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# fixture = use data/raw/open_meteo_boston_sample.json (default, reproducible)
# live = call Open-Meteo API (no key required)
WEATHER_MODE=fixture

MAX_AGENT_STEPS=5
